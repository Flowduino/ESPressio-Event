{
    "name": "ESPressio-Event",
    "description": "Event-Pattern library for ESP32-family microcontrollers",
    "keywords": "event,events,event-driven,event pattern,pattern,design pattern,async,callback,watcher,notifier,espressio",
    "authors": {
        "name": "Flowduino",
        "maintainer": true,
        "url": "https://flowduino.com"
    },
    "build": {
        "flags": [
            "-frtti",
            "-DESPRESSIO_EVENT"
        ],
        "unflags": [
            "-fno-rtti"
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Flowduino/ESPressio-Event.git"
    },
    "version": "5.0.1",
    "license": "Apache-2.0",
    "frameworks": "arduino",
    "platforms": "espressif32",
    "dependencies": [
        {
            "name": "ESPressio-Threads",
            "version": ">=3.0.0",
            "url": "https://github.com/Flowduino/ESPressio-Threads.git",
            "platforms": "espressif32"
        },
        {
            "name": "Flowduino ESPressio-Observable",
            "version": ">=3.0.0",
            "url": "https://github.com/Flowduino/ESPressio-Observable.git",
            "platforms": "*"
        }
    ]
}
